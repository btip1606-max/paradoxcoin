[Desktop Entry]
Version=1.0
Name=paradoxcoin Core
Comment=Connect to the paradoxcoin P2P Network
Comment[de]=Verbindung mit dem paradoxcoin Peer-to-Peer-Netzwerk herstellen
Comment[es]=Conectar a la red P2P de paradoxcoin
Comment[fr]=Se connecter au réseau pair à pair paradoxcoin
GenericName=Cryptocurrency Wallet
Exec=paradoxcoin-qt %u
Terminal=false
Type=Application
Icon=paradoxcoin128
MimeType=x-scheme-handler/paradoxcoin;
Categories=Office;Finance;Network;
Keywords=paradoxcoin;crypto;cryptocurrency;wallet;blockchain;
StartupNotify=true
StartupWMClass=paradoxcoin-qt
